        "tailwind-merge": "^2.6.0"
    },
    "devDependencies": {
        "@arkade-os/sdk": "0.4.45",
        "@types/react": "^19.0.0",
        "@types/react-dom": "^19.0.0",
        "lucide-react": "^0.469.0",
        "react": "^19.0.0",
        "react-dom": "^19.0.0",
