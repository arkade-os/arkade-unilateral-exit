{
    "name": "arkade-unilateral-exit",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "description": "Keyless web executor for Arkade unilateral exit packages.",
    "license": "MIT",
    "scripts": {
        "dev": "pnpm --filter @arkade-os/exit-ui build && vite",
        "build": "pnpm --filter @arkade-os/exit-ui build && tsc -b && vite build",
        "preview": "vite preview",
        "typecheck": "pnpm --filter @arkade-os/exit-ui build && tsc -b --noEmit",
        "test": "pnpm -r test",
        "lint": "prettier --check .",
        "format": "prettier --write ."
    },
    "dependencies": {
        "@arkade-os/exit-ui": "workspace:*",
        "@arkade-os/sdk": "0.4.45",
        "@radix-ui/react-progress": "^1.1.2",
        "@radix-ui/react-slot": "^1.1.2",
        "@radix-ui/react-tooltip": "^1.2.16",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "lucide-react": "^0.469.0",
        "react": "^19.0.0",
        "react-dom": "^19.0.0",
        "tailwind-merge": "^2.6.0"
    },
    "devDependencies": {
        "@tailwindcss/vite": "^4.0.0",
        "@types/node": "^24.0.0",
        "@types/react": "^19.0.0",
        "@types/react-dom": "^19.0.0",
        "@vitejs/plugin-react": "^4.3.4",
        "prettier": "^3.4.2",
        "tailwindcss": "^4.0.0",
        "typescript": "^5.9.0",
        "vite": "^6.0.7",
        "vitest": "^3.0.0"
    },
    "packageManager": "pnpm@10.25.0"
}
